<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      USE_FINGERPRINT is declared by `androidx.biometric:biometric:1.1.0`
      (the legacy fingerprint-era permission). The app authenticates with
      BiometricPrompt and never reads fingerprint state directly; the
      permission is superseded by android.permission.USE_BIOMETRIC and
      adds nothing to the merged manifest the app needs. Removing it here
      keeps the disclosure (Data Safety form + merged manifest) accurate.
      See API_DEPRECATION_AUDIT.md, D1 (2026-11-22).
    -->
    <uses-permission
        android:name="android.permission.USE_FINGERPRINT"
        tools:node="remove" />

    <application
        android:name=".CycleCareApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CycleCare"
        tools:targetApi="s">
        <profileable
            android:shell="true"
            tools:targetApi="q" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${adMobApplicationId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CycleCare">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ReminderRescheduleReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Delivers a reminder when its alarm fires. Not exported: the alarm
          is a PendingIntent owned by the app, and nothing else should be
          able to trigger a delivery.
        -->
        <receiver
            android:name=".ReminderAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          Posts the coalesced summary of candidates that were deferred
          into quiet hours, DND or an arbitration fold. Only the app's own
          alarm can wake it, so it is not exported.
        -->
        <receiver
            android:name=".ReminderDeferredSummaryReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          The one-tap re-enable behind the auto-disable notice. The
          PendingIntent is built by the app itself, so it does not need to
          be exported either.
        -->
        <receiver
            android:name=".ReminderAutoDisableActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
    </application>

</manifest>
