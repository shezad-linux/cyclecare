<?xml version="1.0" encoding="utf-8"?>
<!--
  CycleCare backup rules for Android 8.0 - 11 (API 26 - 30).

  On these API levels full-backup-content governs BOTH cloud backup and
  device-to-device transfer; there is no way to configure them
  separately. data_extraction_rules.xml only takes effect from API 31.

  Everything is therefore excluded, which means:

    - no health data is written to Google's cloud backup  (privacy goal)
    - device-to-device transfer is NOT available on API 26-30

  That trade is deliberate. Losing privacy on every user to gain
  convenience on legacy devices is the wrong direction for a
  reproductive-health app, and API 26-30 devices are a small and
  shrinking share of the installed base.

  Users on those API levels get the encrypted export/import file
  instead (Release N+1), which works on every Android version and does
  not depend on the OS backup service at all.

  See CycleCare-Redesign-Docs/02-database-and-sync.md §9.9.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>